#trigger !stats
#name Stats Command
#type prefix
#description Provides current statistics about the ZBR language, including total functions, categories, triggers, and the latest version.

ZhttpGet{https://zbrlang.vercel.app/api/stats}
ZjsonParse{ZhttpResult{}}
Zdescription{# ZBR Statistics
Current state of the ZBR language}
ZaddField{Total Functions;ZjsonGet{functionsCount};true}
ZaddField{Categories;ZjsonGet{categoriesCount};true}
ZaddField{Total Triggers;ZjsonGet{triggersCount};true}
ZaddField{Trigger Types;6;true}
ZaddField{Latest Version;ZjsonGet{version};true}
Zcolor{#ffffff}
Zfooter{ZBR Support | Statistics}
ZfooterIcon{ZuserAvatar{ZbotID{}}}