}

Zif{Zmessage{1}!=;
  Zvar{cat_arg;Zlowercase{Zmessage{1}}}
  Zvar{catdata;ZgetServerVar{Zvar{cat_arg}}}
  ZonlyIf{Zvar{catdata}!=;Unknown category "Zmessage{1}". Use `!category` to see all categories.}

  ZtextSplit{Zvar{catdata};|}
  Zvar{count;ZgetTextSplitLength{}}
  Zdescription{# ZBR Function Categories (42)
  **Category: Zvar{cat_arg}**}
  Zcolor{#ffffff}
  ZforSplit{
    Zvar{fn;ZloopValue{}}
    Zvar{flist;Zvar{flist} 
    Zvar{fn}}
  }
  ZaddField{Functions;Zvar{flist};false}
  Zfooter{ZBR Support | Use !find to search for specific functions}
  ZfooterIcon{ZuserAvatar{ZbotID{}}}
}