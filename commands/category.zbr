#trigger !category
#name Category List
#type prefix
#description List all functions in a ZBR category, or see all categories. Categories group functions by purpose (moderation, embeds, roles, etc.).

Zif{Zmessage{1}==;
Zdescription{# ZBR Function Categories (42)
Use `!category <name>` to list functions in a specific category.}
Zcolor{#ffffff}
ZaddField{actions;Send, reply, and manage message outputs;false}
ZaddField{audit;Query Discord audit logs;false}
ZaddField{automod;Create and manage auto-moderation rules;false}
ZaddField{blacklists;Manage user, role, and server blacklists;false}
ZaddField{bot;Bot information and utilities;false}
ZaddField{channels;Channel operations and queries;false}
ZaddField{components;Buttons, select menus, modals, and UI components;false}
ZaddField{context;Access context (author, message, guild data);false}
ZaddField{control;Control flow, conditions, and argument checking;false}
ZaddField{cooldown;Command cooldown management;false}
Zfooter{ZBR Support | Page 1 of 5}
ZfooterIcon{ZuserAvatar{ZbotID{}}}
ZaddButton{no;cat1;Next Page;secondary}
}

Zif{ZgetServerVar{_cached}!=true;
ZsetServerVar{actions;Zreply|ZreplyIn|ZsendMessage}
ZsetServerVar{audit;ZauditCount|ZauditEntries|ZauditEntryAction|ZauditEntryChanges|ZauditEntryID|ZauditEntryReason|ZauditEntryTarget|ZauditEntryUser|ZauditLatest}
ZsetServerVar{automod;ZautomodRule|ZautomodRuleCreate|ZautomodRuleDelete|ZautomodRuleEdit|ZautomodRuleUpdate|ZautomodRules}
